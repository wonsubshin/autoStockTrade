# ========================================================
# KIS AutoStockTrader - Environment Configuration
# ========================================================

# Server Ports
PORT=8100
FRONTEND_PORT=9900

# Gemini AI API Key (SSE market and news analysis)
GEMINI_API_KEY=

# ========================================================
# Database Connection Location Mode: 'local' | 'outer'
# - local : Connects to local PostgreSQL (127.0.0.1:5432)
# - outer : Connects to remote PostgreSQL (OUTER_PG_HOST:OUTER_PG_PORT)
# ========================================================
LOCATION=local

# --------------------------------------------------------
# [Local] PostgreSQL 16 Connection
# --------------------------------------------------------
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5432
LOCAL_PG_DATABASE=stock
LOCAL_PG_USER=stock_trader
LOCAL_PG_PASSWORD=your_local_password_here

# --------------------------------------------------------
# [Outer] Remote PostgreSQL Connection
# --------------------------------------------------------
OUTER_PG_HOST=your-remote-host-or-ip
OUTER_PG_PORT=5432
OUTER_PG_DATABASE=stock
OUTER_PG_USER=stock_trader
OUTER_PG_PASSWORD=your_remote_password_here

