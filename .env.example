# ========================================================
# KIS AutoStockTrader - Environment Configuration
# ========================================================

# Server Ports
PORT=8100
FRONTEND_PORT=9900

# Gemini AI API Key (SSE market and news analysis)
GEMINI_API_KEY=

# ========================================================
# Database Connection Location Mode: 'local' | 'outer'
# - local : Connects to local PostgreSQL (127.0.0.1:5432)
# - outer : Connects to remote PostgreSQL (218.234.55.78:5432)
# ========================================================
LOCATION=local

# --------------------------------------------------------
# [Local] PostgreSQL 16 Connection
# --------------------------------------------------------
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5432
LOCAL_PG_DATABASE=stock_trader
LOCAL_PG_USER=stock_trader
LOCAL_PG_PASSWORD=stock123$%^

# --------------------------------------------------------
# [Outer] Remote PostgreSQL Connection
# --------------------------------------------------------
OUTER_PG_HOST=218.234.55.78
OUTER_PG_PORT=5432
OUTER_PG_DATABASE=stock_trader
OUTER_PG_USER=stock_trader
OUTER_PG_PASSWORD=stock123$%^

